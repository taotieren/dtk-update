[Unit]
Description=dtk-update background monitor service
Documentation=https://github.com/linuxdeepin/dtk-update
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=com.dtk.update.Daemon
ExecStart=/usr/lib/dtk-update/dtk-update-daemon
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
